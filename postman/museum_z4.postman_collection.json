{
  "info": {
    "name": "РБПО Задание 4 — Музейные выставки",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order with the private local environment. Basic Auth + CSRF, USER/ADMIN, five business operations and cleanup."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8085"
    },
    {
      "key": "readerPassword",
      "value": "Museum-Demo-2026!"
    }
  ],
  "item": [
    {
      "name": "01 Получить CSRF и начать сценарий",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [],
        "url": "{{baseUrl}}/api/auth/csrf"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set('csrfToken', pm.response.json().token);",
              "pm.collectionVariables.set('newReader', 'visitor_' + Date.now());",
              "pm.collectionVariables.set('suffix', Date.now().toString());"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Без Basic: 401",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [],
        "url": "{{baseUrl}}/api/exhibits"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Слабый пароль: 400",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"weak_{{suffix}}\", \"fullName\": \"Weak\", \"password\": \"123\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Регистрация не даёт ADMIN",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{newReader}}\", \"fullName\": \"Visitor\", \"password\": \"{{readerPassword}}\", \"role\": \"ADMIN\", \"enabled\": false}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "var user = pm.response.json();",
              "pm.collectionVariables.set('registeredId', user.id);",
              "pm.test('USER, enabled, без password', function () { pm.expect(user.role).to.eql('USER'); pm.expect(user.enabled).to.eql(true); pm.expect(user).not.to.have.property('password'); });"
            ]
          }
        }
      ]
    },
